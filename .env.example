# Copy this file to .env and fill in what you need.
PORT=3000

# Optional but recommended: free key for Google Fact Check Tools API.
# Get one: https://console.cloud.google.com -> enable "Fact Check Tools API" -> Credentials -> API key
GOOGLE_FACTCHECK_API_KEY=

# Shown to Wikipedia in the User-Agent header (their API etiquette asks for contact info)
CONTACT_URL=https://your-site-or-email.example

# Set to production when deploying behind HTTPS (marks cookies Secure)
NODE_ENV=development
# TRUST_PROXY=true   # uncomment when behind a reverse proxy (Render, Railway, nginx...)
